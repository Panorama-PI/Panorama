# Copie para .env.docker e substitua os valores antes de iniciar os containers.
# Use senhas diferentes das credenciais locais e nao use root no app.
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte-do-root
DB_DATABASE=filmes_db
DB_USER=panorama_app
DB_PASSWORD=troque-por-uma-senha-forte-do-app

# Porta publicada no host/EC2. O app escuta na porta 3333 dentro da rede Docker.
APP_PUBLIC_PORT=8080

# Conta SMTP; use uma senha de app, nao a senha normal da conta Google.
EMAIL=seu-email@gmail.com
EMAIL_APP_PASSWORD=troque-pela-senha-de-app

# Planilha .xlsx enviada manualmente ao S3; use a chave do objeto, sem s3://
AWS_REGION=sa-east-1
S3_BUCKET=nome-do-seu-bucket
S3_OBJECT_KEY=dados/imdb_movies.xlsx
